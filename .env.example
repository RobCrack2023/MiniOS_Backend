# Copiar como .env  (el servidor lo carga automáticamente al arrancar)
# chmod 600 .env

PORT=3001

# Secreto para firmar los JWT. Generar uno propio con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Si se deja vacío, el servidor genera uno aleatorio y lo guarda en la base de datos.
JWT_SECRET=

# Token compartido que deben enviar los ESP32 para conectarse a /ws/device
# y para usar los endpoints OTA de dispositivo. Generar con:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# Mientras esté vacío, cualquiera puede conectarse suplantando la MAC de un
# dispositivo. Definirlo aquí y en el firmware del cliente.
DEVICE_TOKEN=

# Orígenes permitidos por CORS, separados por comas.
# Vacío = sin cabeceras CORS (el dashboard va en el mismo origen y no las necesita).
ALLOWED_ORIGINS=

# Días de historial de sensores que se conservan. Vacío o 0 = no borrar nunca.
# La purga corre al arrancar y luego cada 24 h. ¡Es irreversible!
# Sin esto la tabla sensor_data crece sin límite.
DATA_RETENTION_DAYS=30

# Tamaño máximo del .bin de firmware, en MB.
# Debe ser <= client_max_body_size de nginx.
MAX_FIRMWARE_MB=8
